<?xml version="1.0" encoding="utf-8"?>
<!-- One leaderboard row (mirrors web Leaderboard.tsx row) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/leader_rank"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/circle_bg"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/leader_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/web_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/leader_reports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/web_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/leader_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/web_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wc_points"
            android:textColor="@color/web_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
