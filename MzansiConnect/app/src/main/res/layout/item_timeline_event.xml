<?xml version="1.0" encoding="utf-8"?>
<!-- One tracking timeline event (web ReportDetail timeline row) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/circle_bg"
        android:padding="4dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/web_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/timeline_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/web_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timeline_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/web_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
