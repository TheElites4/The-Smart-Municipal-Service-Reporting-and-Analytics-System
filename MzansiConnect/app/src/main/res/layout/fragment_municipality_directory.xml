<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors web MunicipalityDirectory.tsx -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/web_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/web_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wc_municipality_directory"
            android:textColor="@color/web_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wc_municipality_directory_subtitle"
            android:textColor="@color/web_text_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_municipality_search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/web_input"
            android:hint="@string/wc_search_municipality_province"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/web_text"
            android:textColorHint="@color/web_text_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/municipality_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/wc_no_municipalities"
        android:textColor="@color/web_text_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_municipalities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />
</LinearLayout>
