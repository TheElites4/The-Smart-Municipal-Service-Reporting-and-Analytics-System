# Copy to .env or set these in the deployment environment.
DATABASE_URL=postgresql://mzansi:change-me-local-only@localhost:5432/mzansi_connect
PORT=8787
AUTH_SECRET=replace-with-a-long-random-secret
# Staff/admin MFA codes are sent through the Gmail API (HTTPS), not SMTP.
# Configure an OAuth client with the https://www.googleapis.com/auth/gmail.send scope.
GMAIL_USER=your-account@gmail.com
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-oauth-refresh-token
ESKOM_SE_PUSH_TOKEN=replace-with-your-eskomsepush-api-token
# Optional contact identifier for Nominatim reverse-geocoding requests.
GEOCODER_USER_AGENT=MzansiConnect/1.0
# Email OTP MFA applies only to staff/admin dashboard sign-in. Citizen auth and
# Android push notifications use their existing flows.
# Use a trusted reverse proxy or identity provider in production.
ALLOWED_ORIGINS=https://citizen.example.gov.za,https://staff.example.gov.za,https://admin.example.gov.za
