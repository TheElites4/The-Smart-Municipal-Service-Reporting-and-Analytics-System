<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed photo drop-zone border (web border-2 border-dashed) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/web_card" />
    <corners android:radius="12dp" />
    <stroke
        android:width="2dp"
        android:color="@color/web_border"
        android:dashWidth="8dp"
        android:dashGap="6dp" />
</shape>
