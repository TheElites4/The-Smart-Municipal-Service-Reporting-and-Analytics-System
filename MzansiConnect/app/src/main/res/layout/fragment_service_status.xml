<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/portal_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Service Status"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-time monitoring per municipality"
        android:textColor="@color/portal_text_secondary"
        android:textSize="13sp" />

    <!-- Power Status -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:backgroundTint="@android:color/transparent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="20dp"
            android:orientation="vertical">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ Power (Eskom/Municipal)" android:textColor="@color/white" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Stage 2" android:textColor="@color/accent" android:textStyle="bold" />
            </RelativeLayout>
            <ProgressBar android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:progress="70" android:progressTint="@color/accent" style="@android:style/Widget.ProgressBar.Horizontal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Next Switch: 16:00 - 18:30 (Area 4)" android:textColor="@color/portal_text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Water Status -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:backgroundTint="@android:color/transparent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="20dp"
            android:orientation="vertical">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧 Water Supply" android:textColor="@color/white" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Normal" android:textColor="@color/portal_badge_green" android:textStyle="bold" />
            </RelativeLayout>
            <ProgressBar android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:progress="95" android:progressTint="@color/portal_badge_green" style="@android:style/Widget.ProgressBar.Horizontal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Reservoir Levels: 88% Stable" android:textColor="@color/portal_text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>