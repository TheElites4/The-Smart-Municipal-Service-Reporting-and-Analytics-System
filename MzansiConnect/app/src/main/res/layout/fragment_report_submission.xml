<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/portal_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:backgroundTint="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submit Service Report"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <!-- AI SCAN SECTION -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_ai_scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="@color/portal_badge_blue">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_security_small" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="AI CATEGORY SCAN" android:textColor="@color/white" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Issue Category"
                    android:textColor="@color/portal_text_secondary"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_category"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_card"
                    android:backgroundTint="@color/portal_input_bg"
                    android:entries="@array/report_categories" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Detailed Description"
                    android:textColor="@color/portal_text_secondary"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edit_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_card"
                    android:backgroundTint="@color/portal_input_bg"
                    android:gravity="top"
                    android:hint="Describe the issue in detail..."
                    android:inputType="textMultiLine"
                    android:lines="4"
                    android:padding="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/portal_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Location (Auto-GPS)"
                    android:textColor="@color/portal_text_secondary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edit_location"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:backgroundTint="@color/portal_input_bg"
                        android:hint="Coordinates or Address"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/portal_text_secondary" />

                    <ImageButton
                        android:id="@+id/btn_gps"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_home"
                        android:background="@drawable/glass_card"
                        android:backgroundTint="@color/portal_badge_green"
                        app:tint="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_municipality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nearest: Detecting municipality..."
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_submit_report"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="@color/portal_button_orange"
                    android:text="Submit to Municipal Portal"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <CheckBox
                    android:id="@+id/check_safety"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="BROADCAST AS SAFETY ALERT"
                    android:textColor="@color/red"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:buttonTint="@color/red" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>