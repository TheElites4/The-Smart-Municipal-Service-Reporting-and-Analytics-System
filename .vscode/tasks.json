{
  // VS Code tasks for the MzansiConnect stack.
  // Run everything with:  Terminal > Run Task... > "MzansiConnect: run everything"
  // Each task starts in its own terminal panel so you can watch the logs.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MzansiConnect: backend API (8787)",
      "type": "shell",
      "command": "node",
      "args": ["src/server.js"],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "DATABASE_URL": "postgresql://postgres:mhl3ngiprince@localhost:5432/mzansi_connect",
          "AUTH_SECRET": "local-development-secret-please-change-0123456789abcdef",
          "PORT": "8787",
          "ALLOWED_ORIGINS": "*"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "mzansi", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "MzansiConnect: citizen portal (5173)",
      "type": "shell",
      "command": "node",
      "args": ["node_modules/vite/bin/vite.js", "--port", "5173", "--strictPort"],
      "options": { "cwd": "${workspaceFolder}/Citizen Portal Mobile App" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "mzansi", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "MzansiConnect: dashboards (8080)",
      "type": "shell",
      "command": "node",
      "args": ["serve-static.mjs"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "STATIC_PORT": "8080" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "mzansi", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "MzansiConnect: run everything",
      "dependsOrder": "parallel",
      "dependsOn": [
        "MzansiConnect: backend API (8787)",
        "MzansiConnect: citizen portal (5173)",
        "MzansiConnect: dashboards (8080)"
      ],
      "problemMatcher": []
    }
  ]
}
