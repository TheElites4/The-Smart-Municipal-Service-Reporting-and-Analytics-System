# Copy to .env or set these in the deployment environment.
DATABASE_URL=postgresql://mzansi:change-me-local-only@localhost:5432/mzansi_connect
PORT=8787
AUTH_SECRET=replace-with-a-long-random-secret
# Configure at least one real MFA provider. Never commit these values.
# Resend: create an API key and verify the sender domain/address first.
RESEND_API_KEY=
# Temporary Resend testing sender; usually limited to the Resend account email.
MFA_EMAIL_FROM=MzansiConnect <onboarding@resend.dev>
# Or Twilio: use an SMS-capable E.164 sender number (+27...), not a placeholder.
# Find Account SID/Auth Token in Twilio Console; never commit them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=000
ESKOM_SE_PUSH_TOKEN=replace-with-your-eskomsepush-api-token
# Use a trusted reverse proxy or identity provider in production.
ALLOWED_ORIGINS=https://citizen.example.gov.za,https://staff.example.gov.za,https://admin.example.gov.za
