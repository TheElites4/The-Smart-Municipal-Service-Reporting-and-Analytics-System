# Copy to .env or set these in the deployment environment.
DATABASE_URL=postgresql://mzansi:change-me-local-only@localhost:5432/mzansi_connect
PORT=8787
AUTH_SECRET=replace-with-a-long-random-secret
# Staff/admin dashboard MFA uses TOTP (Google Authenticator or any RFC 6238 app).
# The second factor is a 6-digit code the user's app derives from a shared secret;
# no code is ever emailed or texted.
MFA_PROVIDER=totp
# Encrypts TOTP secrets at rest (AES-256-GCM). Use a 64-char hex string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=replace-with-a-64-char-hex-key
# Optional: sends an "authenticator added" notification email after enrollment.
# Without it, enrollment still works; the notice is simply skipped.
RESEND_API_KEY=
MFA_EMAIL_FROM=MzansiConnect <onboarding@resend.dev>
ESKOM_SE_PUSH_TOKEN=replace-with-your-eskomsepush-api-token
# Optional contact identifier for Nominatim reverse-geocoding requests.
GEOCODER_USER_AGENT=MzansiConnect/1.0
# TOTP MFA applies only to staff/admin dashboard sign-in. Citizen auth and
# Android push notifications use their existing flows.
# Use a trusted reverse proxy or identity provider in production.
ALLOWED_ORIGINS=https://citizen.example.gov.za,https://staff.example.gov.za,https://admin.example.gov.za
