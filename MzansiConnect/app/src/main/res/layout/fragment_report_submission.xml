<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors web Citizen Portal ReportForm.tsx -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/web_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header bar: gradient from-[#1e5a7d] to-[#4a8f8f] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/web_form_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_services"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wc_submit_report_title"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wc_tagline"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Category selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wc_select_category"
                android:textColor="@color/web_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/category_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wc_please_select_category"
                android:textColor="@color/urgency_high"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Icon grid of categories (icons are assigned from /api/options at runtime) -->
            <GridLayout
                android:id="@+id/category_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="What happened? Choose an issue or describe it below"
                android:textColor="@color/web_text" />
            <AutoCompleteTextView
                android:id="@+id/edit_issue_type"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/web_input"
                android:hint="Choose an issue"
                android:inputType="none"
                android:paddingHorizontal="14dp" />

            <!-- Description + keyword category suggestion -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wc_description"
                    android:textColor="@color/web_text"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_suggest_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/web_outline_button"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/wc_suggest_category"
                    android:textAllCaps="false"
                    android:textColor="@color/web_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/edit_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/web_input"
                android:gravity="top"
                android:hint="Provide detailed information about the issue..."
                android:inputType="textMultiLine"
                android:lines="5"
                android:padding="14dp"
                android:textColor="@color/web_text"
                android:textColorHint="@color/web_text_muted" />

            <TextView
                android:id="@+id/category_suggestion_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="10dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/description_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/urgency_high"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/description_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 @string/wc_characters"
                android:textColor="@color/web_text_muted"
                android:textSize="11sp" />

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/wc_location"
                android:textColor="@color/web_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_location"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/web_input"
                    android:hint="@string/wc_street_address"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/web_text"
                    android:textColorHint="@color/web_text_muted" />

                <ImageButton
                    android:id="@+id/btn_gps"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/web_outline_button"
                    android:contentDescription="@string/wc_location"
                    android:src="@drawable/ic_traffic"
                    app:tint="@color/web_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/location_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wc_location_required"
                android:textColor="@color/urgency_high"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_municipality_detected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/web_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wc_confirm_municipality"
                android:textColor="@color/web_text_muted"
                android:textSize="12sp" />

            <AutoCompleteTextView
                android:id="@+id/edit_municipality"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/web_input"
                android:completionThreshold="1"
                android:hint="@string/wc_search_municipality"
                android:inputType="none"
                android:paddingHorizontal="14dp"
                android:textColor="@color/web_text"
                android:textColorHint="@color/web_text_muted" />

            <Button
                android:id="@+id/btn_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Add photo (optional, max 3 MB)"
                android:textAllCaps="false" />
            <TextView
                android:id="@+id/photo_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/web_text_muted" />
            <ImageView
                android:id="@+id/photo_preview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Selected report photo preview"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Urgency -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/wc_urgency"
                android:textColor="@color/web_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_urgency_low"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/web_outline_button"
                    android:text="@string/wc_urgency_low"
                    android:textAllCaps="false"
                    android:textColor="@color/web_primary" />

                <Button
                    android:id="@+id/btn_urgency_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/web_hero_button"
                    android:text="@string/wc_urgency_medium"
                    android:textAllCaps="false"
                    android:textColor="@color/black" />

                <Button
                    android:id="@+id/btn_urgency_high"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/web_outline_button"
                    android:text="@string/wc_urgency_high"
                    android:textAllCaps="false"
                    android:textColor="@color/web_primary" />
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_cancel_report"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/web_outline_button"
                    android:text="@string/wc_cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/web_primary" />

                <Button
                    android:id="@+id/btn_submit_report"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/web_hero_button"
                    android:text="@string/wc_submit_report"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>