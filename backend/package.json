{
  "name": "mzansi-connect-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check scripts/setup-database.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "migrate:email-mfa": "node scripts/apply-email-mfa-migrations.mjs",
    "test:municipalities": "node --test --test-reporter=dot test/municipalities.test.mjs",
    "test:staff-phone": "node --test test/staff-phone-api.test.mjs",
    "test:report-photo": "node --test test/report-photo.test.mjs",
    "test:totp": "node --test test/totp.test.mjs",
    "test:auth-email-mfa": "node --test test/auth-email-mfa.test.mjs",
    "setup:database": "node scripts/setup-database.mjs",
    "import:municipalities": "node scripts/import-municipalities.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
