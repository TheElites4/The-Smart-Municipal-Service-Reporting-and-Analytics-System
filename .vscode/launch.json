{
  // Debug configurations for the MzansiConnect stack.
  // F5 -> "API: backend (Node)" gives you breakpoints in backend/src/server.js.
  // The ".vscode/tasks.json" tasks can be attached to a debug session as preLaunchTask.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: backend (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/server.js",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "DATABASE_URL": "postgresql://postgres:mhl3ngiprince@localhost:5432/mzansi_connect",
        "AUTH_SECRET": "local-development-secret-please-change-0123456789abcdef",
        "PORT": "8787",
        "ALLOWED_ORIGINS": "*"
      }
    },
    {
      "name": "Citizen portal: Vite (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/Citizen Portal Mobile App",
      "preLaunchTask": "MzansiConnect: citizen portal (5173)"
    },
    {
      "name": "Admin dashboard: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/Admin%20Dashboard/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "MzansiConnect: dashboards (8080)"
    },
    {
      "name": "Staff dashboard: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/Staff%20Dashboard/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "MzansiConnect: dashboards (8080)"
    }
  ],
  "compounds": [
    {
      "name": "MzansiConnect: API + Admin dashboard",
      "configurations": [
        "API: backend (Node)",
        "Admin dashboard: Chrome"
      ],
      "stopAll": true
    }
  ]
}